
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

.DS_Store

# Instrumented binaries and profile data from tools/coverage.sh
.coverage-build/

tools/__pycache__/
.claude/hooks/__pycache__/

# Working state written by /coverage-loop: the dispatch queue and the iteration
# log. Machine state for a run in progress, regenerated every time -- committing
# it would conflict on every branch and tell a later reader nothing.
**/.claude/artifacts/

# Scratch notes -- outside reads, drafts, working thinking. Deliberately not
# tracked: docs/ is the knowledge base, and anything worth keeping graduates
# into it as a lesson or a reference document.
notes/
